# Keep the build context small and the image free of things it must not carry.
.git
.github
.gitignore
.dockerignore
.DS_Store

# Not needed to build the binary.
docs
scripts
test
README.md
Makefile
docker-compose.yml

# The web console is a separate image with its own build context
# (frontend/Dockerfile); it must never enter the API's.
frontend

# Local build output — never copy a host-built binary into the image.
bin
out
.env
.env.local
